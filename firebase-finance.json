{
  "hosting": {
    "site": "controle-familiar-jonatas",
    "public": "controle-financeiro",
    "ignore": ["firebase-finance.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]},
      {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]},
      {"source": "/*.webmanifest", "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]}
    ],
    "rewrites": [
      {"source": "**", "destination": "/index.html"}
    ]
  }
}
