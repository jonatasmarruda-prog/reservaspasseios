{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "/reservas", "destination": "/reservar.html"},
      {"source": "/reservar", "destination": "/reservar.html"},
      {"source": "**", "destination": "/index.html"}
    ],
    "headers": [
      {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/reservar.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/reservation-portal-v27.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "/reservation-portal-v27.css", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "firestore": {
    "rules": "firestore-v27.rules",
    "indexes": "firestore.indexes.json"
  }
}
